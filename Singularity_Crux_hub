		end
	end

	local n2 = 0

	for k in pairs(tbl3.whitelistedPlayers) do
		if n2 == 0 then
			str ..= "\n[Manually Added]\n"
		end

		str ..= "- " .. k .. "\n"
		n2 += 1
	end

	if n + n2 == 0 then
		return "No protected players"
	end
	return str
end

